import corralon.*

test "Pedido puede entregarse" {
  const arena = new Producto(stock = 10)
  const martillo = new Producto(stock = 10)
  const soldadora = new Producto(stock = 10)

  const items = [
    new Item(cantidad = 2, producto = arena),
    new Item(cantidad = 3, producto = martillo),
    new Item(cantidad = 1, producto = soldadora)
  ]

  const pedido = new Pedido(distancia = 35, items = items)

  assert.that(pedido.puedeEntregarse())
}

test "Pedido con más restricciones puede entregarse" {
  const arena = new Material(stock = 10)
  const martillo = new Herramienta(stock = 10)
  const soldadora = new Herramienta(stock = 10)

  const items = [
    new Item(cantidad = 2, producto = arena),
    new Item(cantidad = 3, producto = martillo),
    new Item(cantidad = 1, producto = soldadora)
  ]

  const pedido = new Pedido(distancia = 35, items = items)

  assert.that(pedido.puedeEntregarse())
}

test "Material con poca cantidad no puede entregarse" {
  const arena = new Material(stock = 10)

  const items = [
    new Item(cantidad = 1, producto = arena)
  ]

  const pedido = new Pedido(distancia = 35, items = items)

  assert.notThat(pedido.puedeEntregarse())
}

test "Herramienta lejana no puede entregarse" {
  const martillo = new Herramienta(stock = 10)

  const items = [
    new Item(cantidad = 3, producto = martillo)
  ]

  const pedido = new Pedido(distancia = 100, items = items)

  assert.notThat(pedido.puedeEntregarse())
}
